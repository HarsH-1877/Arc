# Neon PostgreSQL (pooled connection for app queries)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection (for Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Firebase Client (Firebase Console → Project Settings → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (Firebase Console → Service Accounts → Generate private key)
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Redis — Upstash (production) or local Docker (optional dev)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_URL="redis://localhost:6379"

# Rate limiting
SYNC_RATE_LIMIT_REQUESTS=5
SYNC_RATE_LIMIT_WINDOW="1 h"

# Mock data mode — set false when Neon + Firebase are fully wired
USE_MOCK_DATA=true
NEXT_PUBLIC_USE_MOCK_DATA=true
